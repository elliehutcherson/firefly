[submodule "include/abseil-cpp"]
	path = include/abseil-cpp
	url = https://github.com/abseil/abseil-cpp.git
[submodule "include/googletest"]
	path = include/googletest
	url = https://github.com/google/googletest.git
[submodule "include/crow"]
	path = include/crow
	url = https://github.com/CrowCpp/Crow.git
[submodule "include/asio"]
	path = include/asio
	url = https://github.com/chriskohlhoff/asio.git
[submodule "include/nlohmann"]
	path = include/nlohmann
	url = https://github.com/nlohmann/json.git
[submodule "include/libpqxx"]
	path = include/libpqxx
	url = https://github.com/jtv/libpqxx.git
[submodule "include/cpr"]
	path = include/cpr
	url = https://github.com/libcpr/cpr.git
