# Copy to .env and fill in. .env is gitignored -- never commit real values.
#
# Local dev loads this two ways:
#   * docker compose reads .env automatically (interpolates ${...} below).
#   * Running binaries directly:  set -a; source .env; set +a
#     then ./build/bin/firefly or ./build/bin/backfill_bars

# Alpaca paper-trading API keys (free account at https://alpaca.markets;
# dashboard -> API Keys). Paper keys only -- this project never trades real
# money. Empty means market data and the bar-sync job are disabled.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Only needed when not using the docker-compose default.
# DATABASE_URL=postgres://firefly:firefly@localhost:5432/firefly
