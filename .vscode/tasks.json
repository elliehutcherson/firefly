{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake: configure",
      "type": "shell",
      "command": "cmake --preset dev",
      "problemMatcher": []
    },
    {
      "label": "cmake: build",
      "type": "shell",
      "command": "cmake --build --preset dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "dependsOn": "cmake: configure"
    },
    {
      "label": "frontend: check",
      "type": "npm",
      "script": "check",
      "path": "frontend/",
      "problemMatcher": []
    },
    {
      "label": "frontend: build",
      "type": "npm",
      "script": "build",
      "path": "frontend/",
      "problemMatcher": []
    },
    {
      "label": "build: all",
      "dependsOrder": "parallel",
      "dependsOn": ["cmake: build", "frontend: build"],
      "problemMatcher": []
    }
  ]
}
